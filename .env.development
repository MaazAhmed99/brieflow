# Development-only defaults, committed on purpose: nothing here is secret.
# .env.local overrides these, so a Neon DATABASE_URL there wins.
# Vercel never reads this file.

# Local Postgres from `corepack pnpm@9.15.4 db:local` (PGlite, stored in .data/).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
