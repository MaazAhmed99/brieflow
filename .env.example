# Copy this file to .env.local and fill in the values yourself.
# Never commit .env.local, and never paste these values into chat.
# Add the same variables in Vercel: Project → Settings → Environment Variables.

# ─── v1 (needed for Wed 28 Oct) ──────────────────────────────────────────────

# Neon: Dashboard → your project → Connect. Use the pooled string for the app
# and the direct (unpooled) one for running migrations.
# Locally you can skip these: .env.development points at `db:local` (PGlite).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth: a random secret, for example from
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The site's public URL, e.g. https://brieflow-ten.vercel.app (optional locally)
BETTER_AUTH_URL=

# Vercel Blob: Vercel → Storage → your Blob store → .env.local tab
BLOB_READ_WRITE_TOKEN=

# Payments: "stripe" or "demo" (use "demo" if Stripe won't open an account)
PAYMENT_PROVIDER=stripe
# Stripe (test mode only, keys start with sk_test_ / whsec_):
# Dashboard → Developers → API keys, and Developers → Webhooks for the secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI assistant: "groq" (default, free), "gemini" (free fallback) or "claude" (paid, optional)
AI_PROVIDER=groq
# Groq: console.groq.com → API Keys
GROQ_API_KEY=
# Google AI Studio: aistudio.google.com → Get API key
GEMINI_API_KEY=
# Optional: model ids (check each provider's current free-tier list) and daily limits.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.6-flash
# AI_DAILY_LIMIT_PER_USER=25
# AI_DAILY_LIMIT_GLOBAL=800

# Upstash Redis (rate limits and AI quotas): console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password shared by all seeded demo users (the one-click demo buttons sign in
# with it on the server, so visitors never see it). Any random string, 12+ characters.
DEMO_USER_PASSWORD=

# Vercel Cron sends this as a Bearer token to the nightly reset endpoint.
# Any long random string.
CRON_SECRET=

# ─── v1.1 (leave empty for now; each shows "Not configured" until set) ───────

# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# RESEND_API_KEY=
# DEMO_EMAIL_TO=
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=
# SLACK_WEBHOOK_URL=
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
